<?xml version="1.0" encoding="utf-8"?>
<!--
  The player behind a detail page's artwork.

  Written as a layout rather than built in code for one attribute: surface_type. A PlayerView made
  by hand gets the default surface view, which is punched through the window rather than drawn in
  it — it would ignore the scroll of the page it sits in and come out on top of the gradients and
  the title drawn over the hero. A texture view is an ordinary view and behaves like one.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    app:surface_type="texture_view"
    app:resize_mode="zoom"
    app:use_controller="false"
    app:show_buffering="never" />
